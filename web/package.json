{
  "name": "runners-diary-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:tz": "TZ=America/Los_Angeles vitest run src/lib src/test src/features && TZ=Pacific/Kiritimati vitest run src/lib src/test src/features",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test --config playwright.fullstack.config.ts",
    "generate:api": "openapi-typescript ../src/RunnersDiary.Api/openapi/runnersdiary-api.json -o src/api/generated/schema.d.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@azure/msal-browser": "5.27.0",
    "@hookform/resolvers": "7.0.1",
    "@tanstack/react-query": "^5.105.3",
    "azure-maps-control": "3.7.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^26.7.1",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "6.16.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "^17.1.11",
    "react-is": "19.3.1",
    "react-router": "^8.5.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
