// Key Vault (RBAC) holding exactly one secret: the guest-token signing key (ADR 0031 §2).
param location string
param tags object
param token string
param apiPrincipalId string
@description('azd principal (object id); gets Key Vault Secrets Officer so it can rotate the guest key. Empty = skip.')
param userPrincipalId string
param userPrincipalType string

@description('First provision only: the key generated by infra/hooks/preprovision.sh. Empty afterwards, so re-provisioning never rotates the key.')
@secure()
param guestSigningKeyBootstrap string

var secretsUserRole = '4633458b-17de-408a-b874-0445c86b69e6'
var secretsOfficerRole = 'b86a8fe4-44ce-4948-aee5-eccb2c155cd7'
var guestKeySecretName = 'guest-token-signing-key'

resource vault 'Microsoft.KeyVault/vaults@2026-02-01' = {
  name: 'kv-rd-${token}'
  location: location
  tags: tags
  properties: {
    tenantId: tenant().tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
    enableSoftDelete: true
    softDeleteRetentionInDays: 7
    publicNetworkAccess: 'Enabled'
  }
}

resource guestKey 'Microsoft.KeyVault/vaults/secrets@2026-02-01' = if (!empty(guestSigningKeyBootstrap)) {
  parent: vault
  name: guestKeySecretName
  properties: {
    value: guestSigningKeyBootstrap
    attributes: { enabled: true }
  }
}

// Vault scope rather than secret scope: the secret may not exist yet when roles are assigned (it is created by the
// bootstrap parameter or by an earlier provision). The vault holds exactly one secret.
resource secretsUser 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(vault.id, 'api', secretsUserRole)
  scope: vault
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', secretsUserRole)
    principalId: apiPrincipalId
    principalType: 'ServicePrincipal'
  }
}

resource secretsOfficer 'Microsoft.Authorization/roleAssignments@2022-04-01' = if (!empty(userPrincipalId)) {
  name: guid(vault.id, 'user', secretsOfficerRole)
  scope: vault
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', secretsOfficerRole)
    principalId: userPrincipalId
    principalType: userPrincipalType
  }
}

output name string = vault.name
output vaultUri string = vault.properties.vaultUri
output guestKeySecretName string = guestKeySecretName
