{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Entra": {
      "RequiredScope": "access_as_user"
    },
    "Guest": {
      "Issuer": "runnersdiary-guest",
      "Audience": "runnersdiary-api"
    }
  },
  "RateLimiting": {
    "GuestCreate": { "PermitLimit": 5, "Window": "01:00:00", "GlobalPermitLimit": 60, "GlobalWindow": "01:00:00" },
    "General": { "TokenLimit": 120, "TokensPerPeriod": 60, "ReplenishmentPeriod": "00:00:30" },
    "GpxUpload": { "UserPermitLimit": 30, "GuestPermitLimit": 10, "Window": "01:00:00" },
    "Geocode": { "UserPermitLimit": 20, "GuestPermitLimit": 10, "Window": "00:01:00" },
    "MapsToken": { "UserPermitLimit": 30, "GuestPermitLimit": 10, "Window": "01:00:00" },
    "Health": { "UserPermitLimit": 30, "GuestPermitLimit": 30, "Window": "00:01:00" },
    "AiSummary": { "UserPermitLimit": 6, "GuestPermitLimit": 3, "Window": "00:10:00" }
  },
  "Ai": {
    "Provider": "None",
    "Enabled": true,
    "Quotas": { "UserPer24h": 10, "GuestPerAccount": 3, "GlobalPer24h": 200, "GuestGlobalPer24h": 60 }
  },
  "GpxLimits": {
    "MaxFileBytes": 20971520,
    "GuestMaxFileBytes": 5242880,
    "UserMaxTracks": 2000,
    "GuestMaxTracks": 16,
    "MaxPoints": 250000,
    "MaxConcurrentProcessing": 2
  },
  "Maps": {
    "Provider": "MapLibre",
    "MapLibre": { "StyleUrl": "https://tiles.openfreemap.org/styles/liberty" },
    "Geocoding": { "Provider": "None", "GlobalDailyLimit": 75 }
  },
  "RunLimits": {
    "GuestMaxRuns": 500,
    "UserMaxRuns": 20000,
    "MaxRunsPerDate": 20
  },
  "RequestLimits": {
    "MaxBodyBytes": 65536
  }
}
