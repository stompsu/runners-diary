{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Entra": {
      "RequiredScope": "access_as_user"
    },
    "Guest": {
      "Issuer": "runnersdiary-guest",
      "Audience": "runnersdiary-api"
    }
  },
  "RateLimiting": {
    "GuestCreate": { "PermitLimit": 5, "Window": "01:00:00", "GlobalPermitLimit": 60, "GlobalWindow": "01:00:00" },
    "General": { "TokenLimit": 120, "TokensPerPeriod": 60, "ReplenishmentPeriod": "00:00:30" }
  },
  "RunLimits": {
    "GuestMaxRuns": 500,
    "UserMaxRuns": 20000,
    "MaxRunsPerDate": 20
  },
  "RequestLimits": {
    "MaxBodyBytes": 65536
  }
}
