<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Build-time OpenAPI document, committed and consumed by web/ (ADR 0002). -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name runnersdiary-api</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunnersDiary.ServiceDefaults\RunnersDiary.ServiceDefaults.csproj" />
    <ProjectReference Include="..\RunnersDiary.Infrastructure\RunnersDiary.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: the Api is the startup project for `dotnet ef`; nothing flows to consumers or the published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Demo dataset for guest accounts (ADR 0011): runs.json + GPX files are copied next to the binaries as seed/demo/. tools/ and README stay out. -->
    <Content Include="..\..\seed\demo\runs.json" Link="seed\demo\runs.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\seed\demo\gpx\*.gpx" Link="seed\demo\gpx\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RunnersDiary.Api.Tests" />
  </ItemGroup>

</Project>
