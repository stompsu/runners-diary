{
  "openapi": "3.1.1",
  "info": {
    "title": "RunnersDiary.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Aggregate API health for the web app shell.",
        "operationId": "getApiHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiHealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/client-config": {
      "get": {
        "tags": [
          "ClientConfig"
        ],
        "summary": "Runtime configuration for the SPA (Entra sign-in values, or null when sign-in is unavailable).",
        "operationId": "getClientConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientConfigResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/guest-sessions": {
