{
  "openapi": "3.1.1",
  "info": {
    "title": "RunnersDiary.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Aggregate API health for the web app shell.",
        "operationId": "getApiHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiHealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiHealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiHealthResponse": {
        "required": [
          "status",
          "version"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ApiHealthStatus"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ApiHealthStatus": {
        "enum": [
          "Unhealthy",
          "Degraded",
          "Healthy"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    }
  ]
}