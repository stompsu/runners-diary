root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning

# CA1515 (make public types internal): Minimal API types are public so tests and the OpenAPI generator can see them.
dotnet_diagnostic.CA1515.severity = none
# CA2007 (ConfigureAwait): ASP.NET Core has no SynchronizationContext.
dotnet_diagnostic.CA2007.severity = none

[tests/**.cs]
# CA1707 (no underscores in identifiers): test names use Method_Scenario_Result.
dotnet_diagnostic.CA1707.severity = none

[src/RunnersDiary.Infrastructure/Persistence/Migrations/*.cs]
# EF-generated migrations and snapshot: not hand-maintained, so style/quality analyzers (CA1861, IDE0161, ...) don't apply.
generated_code = true
